# Dual-mode API switch for heroui-mobile
# true  = fixtures + mock Account (no backend required)
# false = live REST against API_URL
EXPO_PUBLIC_USE_MOCK=true

# Backend base URL (no trailing slash). LAN IP for physical devices.
EXPO_PUBLIC_API_URL=http://192.168.0.106:9000

# Google Maps / Places (FlipSentry Mobile Maps key from GCP)
# Enable: Places API, Geocoding API, Time Zone API, Maps SDK for Android/iOS
# Used for live location autocomplete when EXPO_PUBLIC_USE_MOCK=false
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Mock credentials (USE_MOCK=true only):
#   email:    test@flipsentry.com
#   phone:    +12345678901
#   password: password
#   OTP:      000000
