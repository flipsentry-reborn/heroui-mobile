# Dual-mode API switch for heroui-mobile (read by app.config.ts → extra.useMock)
# true  = stores → agent → mocks/services (no FlipSentry backend required)
# false = stores → agent → live REST against API_URL
# After changing this value, restart Metro with cache clear: npx expo start --clear
EXPO_PUBLIC_USE_MOCK=true

# Backend base URL (no trailing slash). LAN IP for physical devices.
EXPO_PUBLIC_API_URL=http://192.168.0.106:9000

# Google Maps / Places (FlipSentry Mobile Maps key from GCP)
# Enable: Places API, Geocoding API, Time Zone API, Maps SDK for Android/iOS
# Map tiles may still load in mock mode; Places autocomplete is mocked when USE_MOCK=true
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Mock credentials (EXPO_PUBLIC_USE_MOCK=true only):
#   email:    test@flipsentry.com
#   phone:    +12345678901
#   password: password
#   OTP:      000000
